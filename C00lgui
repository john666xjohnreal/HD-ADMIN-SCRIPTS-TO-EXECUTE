local flyHack = false
flyBtn.MouseButton1Click:Connect(function()
	flyHack = not flyHack
	if flyHack then
		flyBtn.Text = "Fly: on"
		flyBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		local humanoid = nil
		task.spawn(function()
			while flyHack do
				local fps = RunService.RenderStepped:Wait()
				if not humanoid or not humanoid.Parent or not humanoid.Parent.Parent then
					if player.Character and player.Character:FindFirstChild("Humanoid") then
						humanoid = player.Character.Humanoid
						humanoid.PlatformStand = true
					end
				else
					humanoid.PlatformStand = true
					if humanoid.RootPart then
						if humanoid.RootPart:FindFirstChild("NoGravity") then
							humanoid.RootPart.NoGravity.Force = Vector3.new(0, Workspace.Gravity * humanoid.RootPart.AssemblyMass, 0)
						else
							local no = Instance.new("BodyForce")
							no.Name = "NoGravity"
							no.Force = Vector3.new(0, Workspace.Gravity * humanoid.RootPart.AssemblyMass, 0)
							no.Parent = humanoid.RootPart
						end
						local vel = humanoid.MoveDirection * humanoid.WalkSpeed
						if humanoid.Jump then
							vel = vel + Vector3.new(0, humanoid.WalkSpeed, 0)
						end
						if keys.LeftShift then
							vel = vel + Vector3.new(0, -humanoid.WalkSpeed, 0)
						end
						humanoid.RootPart.AssemblyLinearVelocity = ((humanoid.RootPart.AssemblyLinearVelocity - vel) * (0.75 ^ (30 / (1 / fps)))) + vel
					end
				end
			end
		end)
	else
		flyBtn.Text = "Fly: off"
		flyBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		RunService.RenderStepped:Wait()
		RunService.RenderStepped:Wait()
		if player.Character and player.Character:FindFirstChild("Humanoid") then
			player.Character.Humanoid.PlatformStand = false
			if player.Character.Humanoid.RootPart and player.Character.Humanoid.RootPart:FindFirstChild("NoGravity") then
				player.Character.Humanoid.RootPart.NoGravity:Destroy()
			end
		end
	end
end)
